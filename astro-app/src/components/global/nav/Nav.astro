---
import BurgerIcon from "../icons/BurgerIcon.astro"
import XIcon from "../icons/XIcon.astro"
import heroheadline from "../../../assets/hero_headline.webp"

const navLinks = [
  { label: "Inicio", id: "hero" },
  { label: "Sobre mí", id: "sobre-mi" },
  { label: "Enfoque", id: "enfoque" },
  { label: "Terapias online", id: "terapias" },
  { label: "Testimonios", id: "testimonios" },
  { label: "Precios", id: "precios" },
  { label: "Preguntas frecuentes", id: "faq" },
]
---

<nav id="main-nav" class="fixed top-0 left-0 w-full z-[200] bg-white transition-all duration-300">

  <div class="flex items-center justify-between px-6 py-3 max-w-6xl mx-auto">

    <!-- Logo -->
    <button id="nav-logo" aria-label="Ir al inicio" class="cursor-pointer">
      <img src="/favicon.ico" alt="Psintiendo el mundo logo" class="h-10 w-auto" />
    </button>

    <!-- Links desktop -->
    <ul class="hidden lg:flex items-center gap-8">
      {navLinks.map(({ label, id }) => (
        <li>
          <button
            data-target={id}
            class="nav-link font-poppins font-semibold text-sm text-brown tracking-wider hover:text-violet transition-colors duration-200 cursor-pointer"
          >
            {label}
          </button>
        </li>
      ))}
    </ul>

    <!-- Burger mobile -->
    <button id="burger-btn" aria-label="Abrir menú" class="lg:hidden text-brown cursor-pointer">
      <BurgerIcon class="size-6" />
      <XIcon class="size-6 hidden" />
    </button>

  </div>

  <!-- Menu mobile -->
  <div id="mobile-menu" class="lg:hidden max-h-0 opacity-0 overflow-hidden transition-all duration-300 bg-white">
    <ul class="flex flex-col px-6 pb-6 gap-5">
      {navLinks.map(({ label, id }) => (
        <li>
          <button
            data-target={id}
            class="nav-link font-poppins font-semibold text-sm text-brown tracking-wider hover:text-violet transition-colors duration-200 w-full text-left cursor-pointer"
            data-ga-event="nav_click"
            data-ga-label={label}
          >
            {label}
          </button>
        </li>
      ))}
    </ul>
  </div>

</nav>

<script>
  // Scroll suave a sección
  const scrollToSection = (id: string) => {
    const el = document.getElementById(id)
    if (el) el.scrollIntoView({ behavior: "smooth" })
  }

  // Nav links
  document.querySelectorAll<HTMLElement>('.nav-link').forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.target
      if (target) scrollToSection(target)
      // Cerrar menu mobile si está abierto
      closeMobileMenu()
    })
  })

  // Logo → scroll al hero
  document.getElementById('nav-logo')?.addEventListener('click', () => {
    scrollToSection('hero')
  })

  // Burger menu
  const burgerBtn = document.getElementById('burger-btn')
  const mobileMenu = document.getElementById('mobile-menu')
  const burgerIcon = burgerBtn?.querySelector<HTMLElement>('.size-6:first-child')
  const xIcon = burgerBtn?.querySelector<HTMLElement>('.size-6:last-child')
  let isOpen = false

  const openMobileMenu = () => {
    isOpen = true
    mobileMenu?.classList.replace('max-h-0', 'max-h-96')
    mobileMenu?.classList.replace('opacity-0', 'opacity-100')
    burgerIcon?.classList.add('hidden')
    xIcon?.classList.remove('hidden')
    burgerBtn?.setAttribute('aria-label', 'Cerrar menú')
  }

  const closeMobileMenu = () => {
    isOpen = false
    mobileMenu?.classList.replace('max-h-96', 'max-h-0')
    mobileMenu?.classList.replace('opacity-100', 'opacity-0')
    burgerIcon?.classList.remove('hidden')
    xIcon?.classList.add('hidden')
    burgerBtn?.setAttribute('aria-label', 'Abrir menú')
  }

  burgerBtn?.addEventListener('click', () => {
    isOpen ? closeMobileMenu() : openMobileMenu()
  })

  // Sombra y background al hacer scroll
  const nav = document.getElementById('main-nav')
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      nav?.classList.add('shadow-md')
    } else {
      nav?.classList.remove('shadow-md')
    }
  })
</script>
