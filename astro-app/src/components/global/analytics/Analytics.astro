<script>
  import { dispatchGaResidenceTimeEvent } from "../../../utils/analytics";

  const trackEvent = (eventName: string, label: string) => {
    console.log(eventName, label, window.gtag);
    if (typeof window.gtag === "function") {
      window.gtag("event", eventName, { event_label: label });
    }
  };

  //Tracking whapsapp clicks
  document
    .querySelectorAll<HTMLElement>('[data-ga-event="whatsapp_click"]')
    .forEach((el) => {
      const label = el.dataset.gaLabel || "desconocido";
      el.addEventListener("click", () => {
        trackEvent("whatsapp_click", label);
      });
    });

  //Tracking Terapias Ofrecidas clicks
  document.querySelectorAll<HTMLElement>('[data-ga-event="terapias_ofrecidas_click"]').forEach(el => {
    const label = el.dataset.gaLabel || "desconocido";
    el.addEventListener("click", () => {
        trackEvent("terapias_ofrecidas_click", label);
      });
  })

  //Tracking Nav clicks
  document.querySelectorAll<HTMLElement>('[data-ga-event="nav_click"]').forEach(el => {
    const label = el.dataset.gaLabel || "desconocido";
    el.addEventListener("click", () => {
        trackEvent("nav_click", label);
      });
  })

  //Tracking social media clicks
  document.querySelectorAll<HTMLElement>('[data-ga-event="instagram_click"]').forEach(el => {
    const label = el.dataset.gaLabel || "desconocido";
    el.addEventListener("click", () => {
        trackEvent("instagram_click", label);
      });
  })

  document.querySelectorAll<HTMLElement>('[data-ga-event="facebook_click"]').forEach(el => {
    const label = el.dataset.gaLabel || "desconocido";
    el.addEventListener("click", () => {
        trackEvent("facebook_click", label);
      });
  })

  document.querySelectorAll<HTMLElement>('[data-ga-event="linkedin_click"]').forEach(el => {
    const label = el.dataset.gaLabel || "desconocido";
    el.addEventListener("click", () => {
        trackEvent("linkedin_click", label);
      });
  })

  document.querySelectorAll<HTMLElement>('[data-ga-event="linkedin_jona_click"]').forEach(el => {
    const label = el.dataset.gaLabel || "desconocido";
    el.addEventListener("click", () => {
        trackEvent("linkedin_jona_click", label);
      });
  })

  // Tracking residence time
  const aboutMeSection = document.getElementById("sobre-mi");
  const focusSection = document.getElementById("enfoque");
  const servicesSection = document.getElementById("terapias");
  const testimonialSection = document.getElementById("testimonios");
  const faqSection = document.getElementById("faq");
  
  if (aboutMeSection) {
    aboutMeSection.dataset.gaLabel = "sobre_mi";
    dispatchGaResidenceTimeEvent(aboutMeSection, [5,10,30])
  }

  if (focusSection) {
    focusSection.dataset.gaLabel = "enfoque";
    dispatchGaResidenceTimeEvent(focusSection, [5,10,30])
  }

  if (servicesSection) {
    servicesSection.dataset.gaLabel = "terapias_ofrecidas";
    dispatchGaResidenceTimeEvent(servicesSection, [5,10,30])
  }
  
  if (testimonialSection) {
    testimonialSection.dataset.gaLabel = "testimonios";
    dispatchGaResidenceTimeEvent(testimonialSection, [5,10,30])
  }

  if (faqSection) {
    faqSection.dataset.gaLabel = "preguntas_frecuentes";
    dispatchGaResidenceTimeEvent(faqSection, [5,10,30])
  }

  // Listening ga:track custom event. Used in focusSection, faqSection and aboutMeSection and testimonialSection
  document.addEventListener('ga:track', (e: Event) => {
    const { event_name, event_label } = (e as CustomEvent).detail
    trackEvent(event_name, event_label)
  })
</script>
