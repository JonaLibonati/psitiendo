---
import arrowTopLeft from "../../../assets/arrows/arrow-top-left.png"
import arrowTopRight from "../../../assets/arrows/arrow-top-right.png"
import arrowBottomLeft from "../../../assets/arrows/arrow-bottom-left.png"
import arrowBottomRight from "../../../assets/arrows/arrow-bottom-right.png"

const { text, href, ariaLabel } = Astro.props
---

<div class="relative w-[300px] h-[146px] lg:w-[430px] lg:h-[200px] flex justify-center">
  <a
    href={href}
    aria-label={ariaLabel}
    target="_blank"
    rel="noopener noreferrer"
    class="cursor-pointer button size-fit self-center px-4 py-3 lg:px-5 lg:py-4 bg-steel-blue rounded-full border border-dark-gray shadow-lg hover:bg-brown transition"
    data-ga-event="whatsapp_click"
    data-ga-label="hero"
  >
    {text}
  </a>
  <img class="absolute top-[14px] left-[0px] lg:top-[35px] lg:left-[39px] w-[56px] lg:w-[72px]" src={arrowTopLeft.src} alt="Flecha 1 dibujada a mano apuntando al boton" />
  <img class="absolute top-[0px] right-[-4px] lg:top-[14px] lg:right-[31px] w-[71px] lg:w-[89px]" src={arrowTopRight.src} alt="Flecha 2 dibujada a mano apuntando al boton" />
  <img class="absolute bottom-[0px] left-[0px] lg:bottom-[17px] lg:left-[34px] w-[60px] lg:w-[75px]" src={arrowBottomLeft.src} alt="Flecha 3 dibujada a mano apuntando al boton" />
  <img class="absolute bottom-[-4px] right-[-4px] lg:bottom-[12px] lg:right-[31px] w-[52px] lg:w-[64px]" src={arrowBottomRight.src} alt="Flecha 4 dibujada a mano apuntando al boton" />
</div>
