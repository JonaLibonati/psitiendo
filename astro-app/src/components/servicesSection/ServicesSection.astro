---
import Section from "../primitives/Section.astro"
import SecondaryButton from "../global/buttons/SecondaryButton.astro"
import stickersMobile from "../../assets/stickers_mobile.webp"
import stickersDesktop from "../../assets/stickers_desktop.webp"
import { servicesData } from "../../data/services/servicesData.js"
import { contactData } from "../../data/contact/contactData.js"

import arrow2 from "../../assets/arrows/arrow-top-right.png"
---

<Section id="terapias" headline="TERAPIAS" subheadline="Conoce las terapias online que brindo.">
  <div class="relative h-[50px] md:h-[60px] pb-2 max-w-[660px] m-auto">
    <img class=`absolute z-50 w-[56px] md:w-[72px] invert-20 rotate-240` src={arrow2.src} alt="Flecha dibujada a mano apuntando al boton" />
    <img class=`absolute z-50 w-[56px] md:w-[72px] left-[200px] md:left-[340px] invert-20 rotate-0` src={arrow2.src} alt="Flecha dibujada a mano apuntando al boton" />
  </div>
  <div id="folder" class="folder relative max-w-[660px] m-auto text-white">
    <div id="folder-inner" class="relative z-50 tab-pop">

      <!-- Tabs -->
      <div class="relative">
        {servicesData.map((item, i) => (
          <button
            aria-label={item.ariaLabel}
            data-index={i}
            class:list={[
              "services-tab text-left hover:text-violet-100 cursor-pointer px-5 w-min md:w-fit rounded-t-2xl",
              item.bgColor,
              i === 1 ? "left-[136px] md:left-[204px] absolute top-0 py-2 mt-2 z-20" : "relative z-50 py-3"
            ]}
            data-ga-event="terapias_ofrecidas_click"
            data-ga-label={item.ga_label}
          >
            <h4>{item.headlineTab}</h4>
          </button>
        ))}
      </div>

      <!-- Cards -->
      <ul class="relative h-[580px] md:h-[480px]">
        {servicesData.map((item, i) => (
          <li
            data-index={i}
            class:list={[
              "services-card absolute w-full cursor-pointer",
              i === 0 ? "z-100" : "z-20"
            ]}
            data-ga-event="terapias_ofrecidas_click"
            data-ga-label={item.ga_label}
          >
            <div class:list={[
              "z-50 p-4 md:p-10 rounded-r-2xl rounded-bl-2xl h-[555px] md:h-[460px]",
              item.bgColor,
              i !== 0 ? "rounded-tl-2xl" : ""
            ]}>
              <h3 class="pb-4">{item.headline}</h3>
              <p class="pb-2">{item.subheadline}</p>
              <ul class="md:pl-4">
                {item.list.map((li) => (
                  <li><p class="text-base">• {li}</p></li>
                ))}
              </ul>
              <div class:list={["flex justify-center", item.marginButton]}>
                <SecondaryButton
                  text="AGENDAR SESIÓN"
                  href={contactData.whatsapp.href}
                  ariaLabel="Agendar sesión con la psicóloga Daiana Telesca Farley"
                  gaLabel={item.ga_label}
                />
              </div>
            </div>
          </li>
        ))}
      </ul>

    </div>

    <!-- Fondo azul con stickers -->
    <div class="flex items-center absolute bottom-0 w-[110%] translate-x-[calc(-1/1.1*5%)] h-[81%] md:h-[77%] bg-[#95A2C8] z-80 rounded-2xl shadow-lg">
      <picture class="relative">
        <source media="(max-width: 767px)" srcset={stickersMobile.src} type="image/webp" />
        <source srcset={stickersDesktop.src} type="image/webp" />
        <img
          class="object-cover w-full"
          src={stickersDesktop.src}
          alt="Imagen de stickers de psicologia y migración"
          loading="lazy"
          decoding="async"
        />
      </picture>
    </div>

    <!-- Fondo brown -->
    <div class="absolute bottom-0 w-[106%] translate-x-[calc(-1/1.1*3%)] h-[90%] md:h-[85%] bg-brown z-0 rounded-2xl"></div>

  </div>
</Section>

<script>
  import { dispatchGaAllItemsOpenedEvent } from "../../utils/analytics"

  let currentIndex = -1

  const cards = document.querySelectorAll<HTMLElement>('.services-card')
  const tabs = document.querySelectorAll<HTMLElement>('.services-tab')
  const folderInner = document.getElementById('folder-inner')
  const folder = document.getElementById('folder')

  let allOpenAtLeastOnce: Array<boolean> = new Array(cards.length).fill(false);

  const setCurrentIndex = (index: number) => {

    //GA all cards have been opened at least once event
    dispatchGaAllItemsOpenedEvent(allOpenAtLeastOnce, index, 'terapia_ofrecidas_cards');

    currentIndex = index

    // Folder inner animation
    if (currentIndex === -1) {
      folderInner?.classList.add('tab-pop')
      folderInner?.classList.remove('z-100')
      folderInner?.classList.add('z-50')
    } else {
      folderInner?.classList.remove('tab-pop')
      folderInner?.classList.remove('z-50')
      folderInner?.classList.add('z-100')
    }

    // Cards z-index
    cards.forEach((card, i) => {
      card.classList.remove('z-100', 'z-20')
      if (i === currentIndex) {
        card.classList.add('z-100')
      } else if (i === 0 && currentIndex === -1) {
        card.classList.add('z-100')
      } else {
        card.classList.add('z-20')
      }
    })

    // Tabs styles
    tabs.forEach((tab, i) => {
      tab.classList.remove('relative', 'absolute', 'py-3', 'py-2', 'mt-2', 'z-50', 'z-20', 'top-0')

      if (currentIndex === -1) {
        // Estado inicial
        if (i === 0) {
          tab.classList.add('relative', 'z-50', 'py-3')
        } else {
          tab.classList.add('absolute', 'top-0', 'py-2', 'mt-2', 'z-20')
        }
      } else if (i === currentIndex) {
        tab.classList.add('py-3', 'z-50', 'relative')
      } else {
        tab.classList.add('absolute', 'top-0', 'py-2', 'mt-2', 'z-20')
      }
    })
  }

  // Click en cards
  cards.forEach((card, i) => {
    card.addEventListener('click', () => setCurrentIndex(i))
  })

  // Click en tabs
  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => setCurrentIndex(i))
  })

  // Click outside
  document.addEventListener('click', (e) => {
    if (folder && !folder.contains(e.target as Node)) {
      setCurrentIndex(-1)
    }
  })
</script>
