---
import Section from "../primitives/Section.astro";
import imgMiradaIntegrativa from "../../assets/focus/mirada_integrativa.jpg";
import imgPsicodinamica from "../../assets/focus/psicodinamica.jpg";
import imgDbt from "../../assets/focus/dbt.jpg";
import imgMigra from "../../assets/focus/migracion.jpg";
import imgIntegrar from "../../assets/focus/integrar.jpg";
import imgRitmo from "../../assets/focus/a_tu_ritmo.jpg";
import PlusIcon from "../global/icons/PlusIcon.astro";
import DashIcon from "../global/icons/DashIcon.astro";

const cards = [
  {
    img: imgMiradaIntegrativa,
    headline: "Mirada Integrativa",
    text: "Una mirada integrativa que combina lo mejor de la Psicodinámica y el Enfoque Dialéctico Conductual (DBT) para acompañarte de manera personalizada y adaptarla a tus necesidades y objetivos.",
    ariaLabelOpen: "Ver más información sobre Mirada Integrativa",
    ariaLabelClose: "Ver menos información sobre Mirada Integrativa",
    alt: "Imagen de fondo de rompecabezas",
    showDBT: false,
    ga_label: "modal_mirada_integrativa",
  },
  {
    img: imgPsicodinamica,
    headline: "Enfoque Psicodinámico",
    text: "Desde la visión Psicodinámica nos enfocaremos en comprender tus patrones vinculares inconscientes, explorar tu mundo simbólico, revisar tu historia personal y trabajaremos en tu narrativa y subjetividad.",
    ariaLabelOpen: "Ver más información sobre Enfoque Psicodinámico",
    ariaLabelClose: "Ver menos información sobre Enfoque Psicodinámico",
    alt: "Imagen de fondo de enfoque psicodinámico",
    showDBT: false,
    ga_label: "modal_enfoque_psicodinamico",
  },
  {
    img: imgDbt,
    headline: "Enfoque Dialéctico Conductual",
    text: "Desde el DBT construiremos herramientas para la gestión de las emociones y la tolerancia al malestar, mejoraremos las habilidades de comunicación interpersonal y practicaremos habilidades de mindfulness que te acerquen a vivir una vida más satisfactoria.",
    ariaLabelOpen: "Ver más información sobre Enfoque Dialéctico Conductual",
    ariaLabelClose: "Ver menos información sobre Enfoque Dialéctico Conductual",
    alt: "Imagen de fondo de herramientas de supervivencia y aventura",
    showDBT: true,
    ga_label: "modal_dbt",
  },
  {
    img: imgMigra,
    headline: "Enfoque Migratorio",
    text: "Si sos migrante te acompañaré en la adaptación al nuevo país, transitar el duelo migratorio, focalizaremos en armar una red de apoyo, explorar tus identificaciones como migrante y trabajaremos en una mejor integración de tu identidad migratoria y de los choques culturales.",
    ariaLabelOpen: "Ver más información sobre Enfoque Migratorio",
    ariaLabelClose: "Ver menos información sobre Enfoque Migratorio",
    alt: "Imagen de fondo de mapamundi",
    showDBT: false,
    ga_label: "modal_enfoque_migratorio",
  },
  {
    img: imgIntegrar,
    headline: "¿Por qué integrar?",
    text: "Porque desde la Psicodinámica buscaremos comprender el porqué de tus conductas y desde la DBT trabajaremos en acciones concretas para cambiarlas. Ajusto las herramientas a lo que cada proceso y paciente necesita.",
    ariaLabelOpen: "Ver más información sobre ¿Por qué integrar?",
    ariaLabelClose: "Ver menos información sobre ¿Por qué integrar?",
    alt: "Imagen de fondo de una mente conflictuada",
    showDBT: false,
    ga_label: "modal_porque_integrar",
  },
  {
    img: imgRitmo,
    headline: "A tu ritmo",
    text: "Cada proceso es único y singular. Te acompaño a conocerte, a fortalecer lo que hay dentro tuyo y a sumar herramientas que te ayuden a sentirte más seguro/a y en calma en esta etapa de tu vida.",
    ariaLabelOpen: "Ver más información sobre A tu ritmo",
    ariaLabelClose: "Ver menos información sobre A tu ritmo",
    alt: "Imagen de fondo de un escritorio con una computadora, gafas y elementos de libreria",
    showDBT: false,
    ga_label: "modal_a_tu_ritmo",
  },
];
---

<Section
  id="enfoque"
  headline="ENFOQUE"
  subheadline="Descubre mi enfoque para acompañar tu proceso de forma única."
>
  <ul class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
    {
      cards.map((card) => (
        <li
          class="focus-card relative bg-charcoal h-[450px] w-full rounded-xl overflow-hidden shadow-lg cursor-pointer"
          aria-label={card.ariaLabelOpen}
          data-aria-open={card.ariaLabelOpen}
          data-aria-close={card.ariaLabelClose}
          data-ga-event="modal_enfoque_click"
          data-ga-label={card.ga_label}
        >
          <div class="relative size-full">
            {/* Imagen */}
            <img
              src={card.img.src}
              class="card-img absolute size-full object-cover transition duration-800 opacity-100"
              loading="lazy"
              alt={card.alt}
            />

            {/* Overlay */}
            <div class="absolute bg-charcoal z-30 size-full opacity-20" />

            {/* Botón +/- */}
            <button
              class="card-btn absolute z-50 bg-white rounded-full right-0 bottom-0 m-4 shadow-lg cursor-pointer"
              aria-label={card.ariaLabelOpen}
              data-aria-open={card.ariaLabelOpen}
              data-aria-close={card.ariaLabelClose}
            >
              <PlusIcon class="plus-icon size-10 text-charcoal" />
              <DashIcon class="dash-icon size-10 text-charcoal hidden" />
            </button>

            {/* Contenido */}
            <div class="relative z-60 px-4 py-6">
              <h3 class="relative headline w-fit mb-5">
                {card.headline}
                {card.showDBT && (
                  <span class="dbt-label absolute headline left-0 top-[120px] transition duration-800 opacity-100">
                    {"(DBT)"}
                  </span>
                )}
              </h3>
              <p class="card-text transition duration-800 opacity-0">
                {card.text}
              </p>
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</Section>

<script>
  import { dispatchGaEvent, dispatchGaAllItemsOpenedEvent } from '../../utils/analytics.ts'

  const focusCards = document.querySelectorAll<HTMLElement>(".focus-card");

  let allOpenAtLeastOnce: Array<boolean> = new Array(focusCards.length).fill(false);

  focusCards.forEach((card, i) => {
    let isOpen = false;

    card.addEventListener("click", (e) => {
      isOpen = !isOpen;

      const img = card.querySelector<HTMLElement>(".card-img");
      const text = card.querySelector<HTMLElement>(".card-text");
      const plusIcon = card.querySelector<HTMLElement>(".plus-icon");
      const dashIcon = card.querySelector<HTMLElement>(".dash-icon");
      const dbtLabel = card.querySelector<HTMLElement>(".dbt-label");
      const btn = card.querySelector<HTMLElement>(".card-btn");

      if (isOpen) {
        //GA all cards have been opened at least once event
        dispatchGaAllItemsOpenedEvent(allOpenAtLeastOnce, i, 'enfoque_cards')    
        //GA click event
        dispatchGaEvent(e.currentTarget as HTMLElement)
        //styles and aria labels
        img?.classList.replace("opacity-100", "opacity-0");
        text?.classList.replace("opacity-0", "opacity-100");
        plusIcon?.classList.add("hidden");
        dashIcon?.classList.remove("hidden");
        dbtLabel?.classList.replace("opacity-100", "opacity-0");
        btn?.setAttribute("aria-label", card.dataset.ariaClose || "");
        card.setAttribute("aria-label", card.dataset.ariaClose || "");
      } else {
        img?.classList.replace("opacity-0", "opacity-100");
        text?.classList.replace("opacity-100", "opacity-0");
        plusIcon?.classList.remove("hidden");
        dashIcon?.classList.add("hidden");
        dbtLabel?.classList.replace("opacity-0", "opacity-100");
        btn?.setAttribute("aria-label", card.dataset.ariaOpen || "");
        card.setAttribute("aria-label", card.dataset.ariaOpen || "");
      }
    });
  });
</script>
